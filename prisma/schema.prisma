// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  kakaoId       String?  @unique
  phoneNumber   String?  @unique
  phoneVerified Boolean? @default(false)
  birthDate     String?
  gender        String?
  walletAddress String?  @unique
  privyUserId   String?  @unique
  privyWalletId String?  @unique
  pointBalance  Int      @default(0)

  // 비대칭 키 인증 필드
  publicKey     String?  @unique
  keyAlgorithm  String?  @default("ECDSA_P256")
  keyCreatedAt  DateTime?
  deviceInfo    String?

  // 복구 코드 필드
  recoveryCodeHash      String?   @unique
  recoveryCodeCreatedAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lotteryApplications  LotteryApplication[]
  tickets              Ticket[]
  pointHistories       PointHistory[]
  authChallenges       AuthChallenge[]
  publicKeyHistories   PublicKeyHistory[]
  recoveryAttempts     RecoveryAttempt[]

  @@map("users")
}

model Event {
  id          Int         @id @default(autoincrement())
  title       String
  description String?
  ticketCount Int
  price       Int
  deadline    DateTime
  saleStart   DateTime?
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  rounds  LotteryRound[]
  tickets Ticket[]

  @@index([deadline])
  @@unique([title, deadline])
  @@map("events")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model LotteryRound {
  id                  String      @id @default(cuid())
  eventId             Int
  roundNumber         Int
  status              RoundStatus @default(OPEN)
  resultHash          String?
  drawnAt             DateTime?
  applicationDeadline DateTime
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  event        Event                @relation(fields: [eventId], references: [id])
  applications LotteryApplication[]

  @@unique([eventId, roundNumber])
  @@index([applicationDeadline])
  @@map("lottery_rounds")
}

enum RoundStatus {
  OPEN
  CLOSED
  DRAWN
}

model LotteryApplication {
  id                String            @id @default(cuid())
  roundId           String
  userId            String
  walletAddress     String?
  priority          Int?
  applicationTxHash String?           @unique
  status            ApplicationStatus @default(APPLIED)
  paymentStatus     PaymentStatus     @default(PENDING)
  paymentDeadline   DateTime?
  pointAmount       Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  round  LotteryRound @relation(fields: [roundId], references: [id])
  user   User         @relation(fields: [userId], references: [id])
  ticket Ticket?

  @@unique([roundId, userId])
  @@index([paymentDeadline])
  @@map("lottery_applications")
}

enum ApplicationStatus {
  APPLIED
  WON
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Ticket {
  id                 String   @id @default(cuid())
  applicationId      String?  @unique
  eventId            Int
  userId             String
  tokenId            BigInt?
  txHash             String?  @unique
  used               Boolean  @default(false)
  refunded           Boolean  @default(false)
  encryptedPublicKey String?  // 구매 당시 공개키 (AES-256-GCM 암호화)
  issuedAt           DateTime @default(now())
  updatedAt          DateTime @updatedAt

  application LotteryApplication? @relation(fields: [applicationId], references: [id])
  event       Event               @relation(fields: [eventId], references: [id])
  user        User                @relation(fields: [userId], references: [id])

  @@unique([eventId, tokenId])
  @@map("tickets")
}

model PointHistory {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  type        PointType
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("point_history")
}

enum PointType {
  CHARGE
  USE
  ADJUST
}

model AuthChallenge {
  id          String   @id @default(cuid())
  userId      String
  challenge   String   @unique
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([challenge])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model PublicKeyHistory {
  id           String   @id @default(cuid())
  userId       String
  publicKey    String
  keyAlgorithm String   @default("ECDSA_P256")
  reason       String   // "INITIAL", "RECOVERY", "ROTATION"
  deviceInfo   String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("public_key_history")
}

model RecoveryAttempt {
  id        String   @id @default(cuid())
  userId    String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("recovery_attempts")
}
