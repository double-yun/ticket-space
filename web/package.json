{
  "name": "ticket-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate --schema ../db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../db/prisma/schema.prisma",
    "db:seed": "tsx ../db/prisma/seed.ts",
    "db:studio": "prisma studio --schema ../db/prisma/schema.prisma --hostname 0.0.0.0 --port 5555"
  },
  "dependencies": {
    "@alchemy/aa-accounts": "^3.19.0",
    "@alchemy/aa-alchemy": "^3.19.0",
    "@alchemy/aa-core": "^3.19.0",
    "@auth/prisma-adapter": "^2.10.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@prisma/client": "^6.16.1",
    "@types/qrcode": "^1.5.5",
    "ethers": "^6.13.2",
    "lucide-react": "^0.544.0",
    "next": "15.5.2",
    "next-auth": "^4.24.11",
    "prisma": "^6.16.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "swiper": "^12.0.1",
    "viem": "^2.37.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "prisma": {
    "schema": "../db/prisma/schema.prisma"
  }
}
